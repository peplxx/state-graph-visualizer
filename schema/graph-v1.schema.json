{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://state-graph-visualizer/graph-v1.schema.json",
  "title": "State Transition Graph",
  "description": "YAML формат для графов переходов состояний в задачах планирования реального времени",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "default": 1,
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "system": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "m": {
          "type": "number"
        },
        "tasks": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "c": {
                "type": "number"
              },
              "d": {
                "type": "number"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "c",
              "d"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "tasks"
      ],
      "additionalProperties": false
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "type": "boolean"
          },
          "isInitial": {
            "type": "boolean"
          },
          "tasks": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "c": {
                  "default": 0,
                  "type": "number"
                },
                "d": {
                  "default": 0,
                  "type": "number"
                },
                "release": {
                  "default": "none",
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "up",
                        "down",
                        "none"
                      ]
                    },
                    {
                      "type": "string",
                      "const": "↑"
                    },
                    {
                      "type": "string",
                      "const": "↓"
                    },
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": -1
                    }
                  ]
                }
              },
              "required": [
                "c",
                "d",
                "release"
              ],
              "additionalProperties": false
            }
          },
          "children": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "loopback": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "borderColor": {
            "type": "string",
            "minLength": 1
          },
          "fillColor": {
            "type": "string",
            "minLength": 1
          },
          "hatch": {
            "type": "string",
            "enum": [
              "single",
              "cross"
            ]
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "areas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "label": {
            "type": "string"
          },
          "labelPosition": {
            "type": "string",
            "enum": [
              "top-left",
              "top-center",
              "top-right",
              "center",
              "bottom-left",
              "bottom-center",
              "bottom-right"
            ]
          },
          "fillColor": {
            "type": "string",
            "minLength": 1
          },
          "borderColor": {
            "type": "string",
            "minLength": 1
          },
          "hatch": {
            "type": "string",
            "enum": [
              "single",
              "cross"
            ]
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "nodes"
        ],
        "additionalProperties": false
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "algorithm": {
          "default": "dagre",
          "type": "string",
          "enum": [
            "dagre",
            "concentric"
          ]
        }
      },
      "required": [
        "algorithm"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "nodes",
    "areas"
  ],
  "additionalProperties": false
}
