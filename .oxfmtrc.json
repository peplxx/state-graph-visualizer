{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": true,
  "tabWidth": 4,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 80,

  "ignorePatterns": [
    "dist/**",
    "*.min.js",
    "*.json",
    "*.yaml",
    "*.md"
  ],
  "experimentalSortPackageJson": {
    "sortScripts": true
  }
}