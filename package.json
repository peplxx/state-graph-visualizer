{
  "name": "state-graph-visualizer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "schema:generate": "tsx scripts/generate-schema.ts",
    "schema:validate": "tsx scripts/validate-yaml.ts",
    "schema:check": "npm run schema:generate && git diff --exit-code schema/"
  },
  "dependencies": {
    "cytoscape": "^3.34.0",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-dagre": "^4.0.0",
    "cytoscape-fcose": "^2.2.0",
    "js-yaml": "^5.1.0",
    "lucide-react": "^1.21.0",
    "oxfmt": "^0.56.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "oxlint": "^1.69.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
